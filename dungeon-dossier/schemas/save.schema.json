{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "maxLength": 500,
      "$ref": "#/$defs/__schema0"
    },
    "case_id": {
      "$ref": "#/$defs/__schema1"
    },
    "content_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "run_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/__schema1"
          },
          "commitment": {
            "type": "string",
            "enum": [
              "UNSTATED",
              "ASSERTED",
              "COMMITTED",
              "REVISED",
              "RETRACTED",
              "CONTRADICTED"
            ]
          },
          "epistemic": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "SUSPECTED",
              "PROVISIONAL",
              "SUPPORTED",
              "REFUTED",
              "UNRESOLVED"
            ]
          },
          "presentation": {
            "type": "string",
            "enum": [
              "NORMAL",
              "COMPOUND",
              "DISTORTED",
              "HIDDEN",
              "LOCKED",
              "DUPLICATED"
            ]
          },
          "resistance": {
            "$ref": "#/$defs/__schema2"
          },
          "exposed": {
            "type": "boolean"
          }
        },
        "required": [
          "claim_id",
          "commitment",
          "epistemic",
          "presentation",
          "resistance",
          "exposed"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "$ref": "#/$defs/__schema1"
          },
          "acquired": {
            "type": "boolean"
          },
          "grade": {
            "$ref": "#/$defs/__schema3"
          },
          "integrity": {
            "type": "string",
            "enum": [
              "INTACT",
              "DEGRADED",
              "DISPUTED",
              "DESTROYED"
            ]
          },
          "sealed_until_turn": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema2"
              },
              {
                "type": "null"
              }
            ]
          },
          "revealed_details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "evidence_id",
          "acquired",
          "grade",
          "integrity",
          "sealed_until_turn",
          "revealed_details"
        ],
        "additionalProperties": false
      }
    },
    "deck": {
      "type": "object",
      "properties": {
        "draw_pile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "hand": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "discard_pile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "exhaust_pile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "locked_cards": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema1"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "draw_pile",
        "hand",
        "discard_pile",
        "exhaust_pile",
        "locked_cards"
      ],
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "cp": {
          "$ref": "#/$defs/__schema4"
        },
        "stress": {
          "$ref": "#/$defs/__schema4"
        },
        "dp": {
          "$ref": "#/$defs/__schema4"
        },
        "composure": {
          "$ref": "#/$defs/__schema4"
        },
        "coercion": {
          "$ref": "#/$defs/__schema4"
        },
        "trust": {
          "$ref": "#/$defs/__schema4"
        },
        "turn": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "cp",
        "stress",
        "dp",
        "composure",
        "coercion",
        "trust",
        "turn"
      ],
      "additionalProperties": false
    },
    "encounter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "encounter_id": {
              "$ref": "#/$defs/__schema1"
            },
            "flow_node_id": {
              "$ref": "#/$defs/__schema1"
            },
            "round_index": {
              "$ref": "#/$defs/__schema2"
            },
            "entered_flow_nodes": {
              "minItems": 0,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "active_modifiers": {
              "minItems": 0,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "completed_objectives": {
              "minItems": 0,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "shield_durability": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/__schema1"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema4"
              }
            }
          },
          "required": [
            "encounter_id",
            "flow_node_id",
            "round_index",
            "entered_flow_nodes",
            "active_modifiers",
            "completed_objectives",
            "shield_durability"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "used_routes": {
      "minItems": 0,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "acquired_relics": {
      "minItems": 0,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "acquired_enhancements": {
      "minItems": 0,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "save_version": {
      "type": "number",
      "const": 3
    },
    "run": {
      "type": "object",
      "properties": {
        "node_index": {
          "$ref": "#/$defs/__schema2"
        },
        "reward_seed_stream": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "false_confessions": {
          "$ref": "#/$defs/__schema2"
        },
        "completed_node_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "pending_reward_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "claimed_reward_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "acquired_evidence_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "grade_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "$ref": "#/$defs/__schema1"
              },
              "outcome": {
                "$ref": "#/$defs/__schema5"
              },
              "grade": {
                "type": "string",
                "enum": [
                  "S",
                  "A",
                  "B",
                  "C",
                  "D",
                  "F"
                ]
              }
            },
            "required": [
              "node_id",
              "outcome",
              "grade"
            ],
            "additionalProperties": false
          }
        },
        "outcome_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "$ref": "#/$defs/__schema1"
              },
              "outcome": {
                "$ref": "#/$defs/__schema5"
              }
            },
            "required": [
              "node_id",
              "outcome"
            ],
            "additionalProperties": false
          }
        },
        "terminal": {
          "type": "boolean"
        },
        "card_tuning": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema1"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "cp_delta": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "composure_damage_delta": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "coercion_delta": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "required": [
              "cp_delta",
              "composure_damage_delta",
              "coercion_delta"
            ],
            "additionalProperties": false
          }
        },
        "canvassed_topic_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "evidence_grade_by_id": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema1"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "open_route_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "retry_count": {
          "$ref": "#/$defs/__schema2"
        },
        "active_episode_id": {
          "$ref": "#/$defs/__schema0"
        },
        "unlocked_episode_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "completed_episode_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "route_node_ids": {
          "minItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "node_index",
        "reward_seed_stream",
        "false_confessions",
        "completed_node_ids",
        "pending_reward_ids",
        "claimed_reward_ids",
        "acquired_evidence_ids",
        "grade_history",
        "outcome_history",
        "terminal",
        "card_tuning",
        "canvassed_topic_ids",
        "evidence_grade_by_id",
        "open_route_ids",
        "retry_count",
        "active_episode_id",
        "unlocked_episode_ids",
        "completed_episode_ids",
        "route_node_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "case_id",
    "content_version",
    "run_seed",
    "claims",
    "evidence",
    "deck",
    "flags",
    "resources",
    "encounter",
    "used_routes",
    "acquired_relics",
    "acquired_enhancements",
    "save_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "__schema4": {
      "type": "number",
      "minimum": 0
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "BEST_RESOLUTION",
        "PARTIAL_RESOLUTION",
        "COERCED_CONFESSION",
        "FAILED"
      ]
    }
  },
  "$id": "./save.schema.json"
}
