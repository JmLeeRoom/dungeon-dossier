{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/$defs/__schema0"
    },
    "schema_version": {
      "$ref": "#/$defs/__schema2"
    },
    "episodes": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "schema_version",
    "episodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "maxLength": 500,
      "$ref": "#/$defs/__schema1"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "__schema3": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "episode_id": {
          "$ref": "#/$defs/__schema1"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "case_directory": {
          "$ref": "#/$defs/__schema1"
        },
        "slots": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        }
      },
      "required": [
        "episode_id",
        "sequence_index",
        "case_directory",
        "slots"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "COMBAT",
            "EVENT",
            "BOSS"
          ]
        },
        "selection": {
          "type": "string",
          "enum": [
            "FIXED",
            "SEEDED_ONE"
          ]
        },
        "candidates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": [
        "role",
        "selection",
        "candidates"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "#/$defs/__schema7"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ENCOUNTER",
            "EVENT",
            "BOSS"
          ]
        },
        "ref": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "node_id",
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "$id": "./run-strip.schema.json"
}
